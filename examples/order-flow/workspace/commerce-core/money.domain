// The shared library project: the `project`
// header makes this file the folder's
// descriptor, and every file under
// `commerce-core/` becomes a member.
//
// `public` is what lets another project
// reach these by their bare name.
// `internal.domain` deliberately omits it.

project commerce-core

public valuetype Money {
   amount: Number
   currency: String
}

public valuetype ID {
   value: String
}

public entity Address {
   street: String
   city: String
   postalCode: String
   country: String
}
