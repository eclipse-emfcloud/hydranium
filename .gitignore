node_modules
lib
dist
out
# A captured run that is meant to OUTLIVE the run — the green reference a
# later red one is diffed against field by field — is written as `.txt`, not
# `.log`, so this blanket ignore cannot swallow it. A negation naming the
# directory would work too, but every rule here is copied verbatim into the
# public tree, so it would disclose a private layout in the one file everybody
# reads.
*.log
*.tsbuildinfo
tsconfig.tsbuildinfo
.DS_Store

# Langium-generated TextMate grammars (regenerated by `langium generate` /
# copied into the host extension by `yarn build`). Both example depths, since a
# `*` does not cross a separator and a single-package example may sit directly
# under `examples/`.
examples/*/syntaxes/
examples/*/*/syntaxes/

# order-flow's large perf fixture. The GENERATOR is committed
# (`examples/order-flow/server/src/testing/large-workspace.ts`, run via
# `npm --prefix examples/order-flow/server run generate:large-workspace`); its
# ~435 model files are not, since a fixed seed reproduces them byte for byte.
examples/order-flow/workspace-large/

# Theia browser-app generated content (`theia build` produces src-gen/,
# `theia rebuild:browser` rewires native deps under node_modules, the
# `link:plugin` step symlinks the local VS Code extension into plugins/).
examples/order-flow/theia-app/src-gen/
examples/order-flow/theia-app/plugins/
examples/order-flow/theia-app/gen-esbuild*.mjs

# Playwright artefacts. Every package with an e2e tier, not just the Theia app:
# the browser package's `clean` removes its report too, so it is generated output
# by that package's own reckoning, and a report a local run wrote is otherwise
# offered up for commit. (`test-results` is already covered repo-wide below.)
examples/*/*/playwright-report/
.playwright/

# Turbo cache + per-package logs
.turbo
**/.turbo

# Nx leftover cache (nx itself is removed; this keeps stale .nx dirs
# from previous installs out of git status)
.nx

# Test artefacts
coverage
unit-test-results
**/*test-results

# Stryker mutation-audit artefacts (item 6 Element E one-off; the config
# packages/core/stryker.conf.json is checked in, its outputs are not).
**/.stryker-tmp/
**/stryker-report/
**/stryker-setup-*.js

# yalc (local package linking)
.yalc
yalc.lock

# Claude Code — the shared skills are checked in (the repo's AI-onboarding
# surface); the permission allowlist and runtime locks stay local, so a clone
# inherits no blanket execution grant from this repository.

# Editor / OS
# Sample-workspace settings are intentionally checked in to demonstrate
# the recommended client-side configuration (e.g. completion insertMode).
!examples/*/workspace/.vscode/settings.json
.idea
*.swp
# Editor and tool backups. The ledger merge writes one beside its input on
# every --write, so without this every merge dirties the tree.
*.bak
