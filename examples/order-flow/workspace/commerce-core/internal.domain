// No `project` header, so this is an
// ordinary member of the project
// `money.domain` declares.
//
// `AuditStamp` is not `public`: it resolves
// inside `commerce-core` and must not from
// `orders`. Adding the modifier silently
// repairs `audit-leak.domain`, whose job is
// to fail.

entity AuditStamp {
   stamp: ID
   createdBy: String
   createdAt: String
}
