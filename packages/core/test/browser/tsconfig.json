// The browser test tree's project, for the same reasons as `../tsconfig.json`:
// those files belong to the second project, so the test tree's project
// excludes them. `references` are restated because `extends` drops them.
{
  "extends": "../../tsconfig.browser.test.json",
  "include": ["../../src/browser", "."],
  "references": [
    { "path": "../../tsconfig.json" },
    { "path": "../../../protocol" },
    { "path": "../../../langium" }
  ]
}
