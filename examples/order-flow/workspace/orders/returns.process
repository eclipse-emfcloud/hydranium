// A second process over the same entity, so
// `.domain` declarations are shared rather
// than owned by one `.process`. Renaming
// `Order.status` has to update both.

process Returns for Order {
   task Receive reads Order.id
   gateway Restockable
      yes -> Restock
      no -> Scrap
   task Restock writes Order.status = NEW
   task Scrap writes Order.status = CANCELLED
   transition Receive -> Restockable
}
