{
  "name": "bookstore-host-vscode",
  "displayName": "Bookstore",
  "version": "0.0.0",
  "private": true,
  "description": "Bookstore in VS Code: the language client, a Show Model command reading a file through the data head, and a custom editor for each diagram.",
  "license": "UNLICENSED",
  "author": "",
  "publisher": "bookstore",
  "main": "./out/extension.js",
  "scripts": {
    "build": "npm run copy:syntaxes && npm run typecheck && tsc && node esbuild.mjs",
    "clean": "rimraf out syntaxes tsconfig.tsbuildinfo test-results playwright-report",
    "copy:syntaxes": "node -e \"require('node:fs').cpSync('../server/syntaxes', 'syntaxes', { recursive: true })\"",
    "lint": "oxlint --report-unused-disable-directives --format stylish --config ../../../oxlint.config.cjs src test --max-warnings 0",
    "start": "node start.mjs",
    "test:e2e": "playwright test --tsconfig tsconfig.e2e.json",
    "test:e2e:install": "node --experimental-strip-types test/install-vscode.mts",
    "typecheck": "tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.e2e.json",
    "watch": "concurrently --kill-others --names syntaxes,tsc,webview \"npm run watch:syntaxes\" \"tsc --watch\" \"node esbuild.mjs --watch\"",
    "watch:syntaxes": "node -e \"const copy = () => require('node:fs').cpSync('../server/syntaxes', 'syntaxes', { recursive: true }); copy(); require('node:fs').watch('../server/syntaxes', copy)\""
  },
  "dependencies": {
    "@eclipse-glsp/client": "2.7.0",
    "@eclipse-glsp/vscode-integration": "2.7.0",
    "@eclipse-glsp/vscode-integration-webview": "2.7.0",
    "@hydranium/bookstore-client": "0.0.0",
    "@hydranium/bookstore-protocol": "0.0.0",
    "@hydranium/client-vscode": "^1.0.0-next",
    "@hydranium/data-client-vscode": "^1.0.0-next",
    "@hydranium/glsp-client": "^1.0.0-next",
    "@hydranium/glsp-client-vscode": "^1.0.0-next",
    "@hydranium/protocol": "^1.0.0-next",
    "bookstore-vscode-servers": "0.0.0",
    "inversify": "^6.1.3",
    "vscode-jsonrpc": "9.0.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "bookstore.showModel",
        "title": "Show Model",
        "category": "Bookstore"
      }
    ],
    "customEditors": [
      {
        "viewType": "bookstore.diagram",
        "displayName": "Bookstore Diagram",
        "selector": [
          {
            "filenamePattern": "*.bookstore"
          }
        ],
        "priority": "default"
      }
    ],
    "grammars": [
      {
        "language": "bookstore",
        "scopeName": "source.bookstore",
        "path": "./syntaxes/bookstore.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "bookstore",
        "aliases": [
          "Bookstore"
        ],
        "extensions": [
          ".bookstore"
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:bookstore"
  ],
  "engines": {
    "vscode": "^1.101.0"
  }
}
