{
  "name": "@hydranium/example-order-flow-client",
  "version": "0.0.0",
  "private": true,
  "description": "Host-agnostic order-flow web client: the `.process` GLSP diagram definition (element type ids, model/view registrations, container module) plus the data head's transport port, the session over it and a document-scoped properties model, written to be mounted by the Theia, VS Code and browser shells.",
  "homepage": "https://github.com/eclipse-emfcloud/hydranium",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-emfcloud/hydranium.git",
    "directory": "examples/order-flow/client"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "style"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "eslint src test --max-warnings 0",
    "test": "npm run typecheck:test && vitest run",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "watch": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@eclipse-glsp/client": "2.7.0",
    "@eclipse-glsp/protocol": "2.7.0",
    "@hydranium/protocol": "^1.0.0-next",
    "inversify": "^6.1.3",
    "vscode-jsonrpc": "~9.0.1"
  },
  "devDependencies": {
    "@hydranium/core": "^1.0.0-next",
    "@hydranium/data-server": "^1.0.0-next",
    "@hydranium/example-order-flow-server": "0.0.0",
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
