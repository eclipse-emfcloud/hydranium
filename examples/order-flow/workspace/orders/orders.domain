// The consuming project. `requires
// commerce-core` is what lets the fields
// below name `ID`, `Money` and `Address`
// across a project boundary.
//
// Nothing here is `public`: a leaf
// project's declarations only have to reach
// the `.process` files beside them.

project orders requires commerce-core

entity Order {
   id: ID
   status: OrderStatus
   total: Money
   shipTo: Address
   lines: LineItem[]
}

enum OrderStatus { NEW, PAID, SHIPPED, CANCELLED }

entity LineItem {
   sku: ID
   quantity: Number
   price: Money
}
