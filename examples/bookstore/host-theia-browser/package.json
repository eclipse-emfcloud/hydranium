{
  "name": "@hydranium/bookstore-host-theia-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Bookstore in a Theia browser application: the Theia extension, and the servers extension sideloaded for the language client.",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "theia build --mode development && npm run typecheck",
    "clean": "rimraf lib src-gen plugins gen-esbuild.browser.mjs gen-esbuild.node.mjs smoke-workspace test-results playwright-report",
    "lint": "oxlint --report-unused-disable-directives --format stylish --config ../../../oxlint.config.cjs test --max-warnings 0",
    "start": "node start.mjs",
    "test:e2e": "playwright test --tsconfig tsconfig.e2e.json",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@hydranium/bookstore-theia": "0.0.0",
    "@theia/core": "^1.75.0",
    "@theia/editor": "^1.75.0",
    "@theia/filesystem": "^1.75.0",
    "@theia/markers": "^1.75.0",
    "@theia/messages": "^1.75.0",
    "@theia/monaco": "^1.75.0",
    "@theia/navigator": "^1.75.0",
    "@theia/output": "^1.75.0",
    "@theia/plugin-ext": "^1.75.0",
    "@theia/plugin-ext-vscode": "^1.75.0",
    "@theia/preferences": "^1.75.0",
    "@theia/process": "^1.75.0",
    "@theia/workspace": "^1.75.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@theia/cli": "^1.75.0",
    "@types/node": "^22.0.0",
    "bookstore-vscode-servers": "0.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Bookstore",
        "connectionBufferBytes": 102400,
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    },
    "backend": {
      "config": {
        "connectionBufferBytes": 102400,
        "frontendConnectionTimeout": 60000
      }
    }
  }
}
