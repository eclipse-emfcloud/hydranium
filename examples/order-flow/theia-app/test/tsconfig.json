// Exists for the EDITOR only. Playwright, the one runner here, is handed
// `../tsconfig.e2e.json` by `--tsconfig`, so no transform discovers this file
// and it needs no `include` of its own. This tier's tests are type-checked by
// `../tsconfig.e2e.json` rather than a `tsconfig.test.json`, because they run
// in Node under Playwright and need the `node` types the worker and page
// projects deliberately drop.
//
// Without this file the tests belong to no editor-discoverable project, so the
// TS server infers one that loads every `@types` package in the tree and
// reports `TS2403` clashes between `@types/mocha` and `@types/jest` that no
// `typecheck:test` run reproduces.
{
  "extends": "../tsconfig.e2e.json"
}
