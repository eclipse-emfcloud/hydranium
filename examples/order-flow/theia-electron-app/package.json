{
  "name": "@hydranium/example-order-flow-theia-electron-app",
  "displayName": "Order Flow — Theia Electron App",
  "version": "0.0.0",
  "private": true,
  "description": "The Electron counterpart of ../theia-app: the same order-flow Theia extension and sideloaded servers-only VS Code extension, in a desktop window.",
  "homepage": "https://github.com/eclipse-emfcloud/hydranium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-emfcloud/hydranium.git",
    "directory": "examples/order-flow/theia-electron-app"
  },
  "main": "lib/backend/electron-main.js",
  "scripts": {
    "build": "npm run link:plugin && theia build --mode development",
    "build:all": "turbo run build --filter=@hydranium/example-order-flow-theia-electron-app...",
    "clean": "theia clean && rimraf src-gen plugins test-results playwright-report",
    "link:plugin": "node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('plugins',{recursive:true});const link=path.resolve('plugins/order-flow-vscode-servers');const existing=fs.lstatSync(link,{throwIfNoEntry:false});if(existing?.isSymbolicLink()){fs.unlinkSync(link)}else{fs.rmSync(link,{force:true,recursive:true})}fs.symlinkSync(path.resolve('../vscode-servers'),link,'junction')\"",
    "lint": "oxlint --format stylish --config ../../../oxlint.config.cjs playwright.config.mts --max-warnings 0",
    "start": "npm run link:plugin && theia start --plugins=local-dir:./plugins ../workspace",
    "test:e2e": "npm run link:plugin && playwright test --tsconfig tsconfig.e2e.json",
    "test:e2e:headed": "npm run link:plugin && playwright test --tsconfig tsconfig.e2e.json --headed",
    "typecheck:test": "tsc --noEmit -p tsconfig.e2e.json",
    "watch": "theia build --watch --mode development"
  },
  "dependencies": {
    "@hydranium/example-order-flow-theia": "0.0.0",
    "@theia/core": "1.74.3",
    "@theia/editor": "1.74.3",
    "@theia/electron": "1.74.3",
    "@theia/filesystem": "1.74.3",
    "@theia/markers": "1.74.3",
    "@theia/messages": "1.74.3",
    "@theia/monaco": "1.74.3",
    "@theia/navigator": "1.74.3",
    "@theia/output": "1.74.3",
    "@theia/plugin-ext": "1.74.3",
    "@theia/plugin-ext-vscode": "1.74.3",
    "@theia/preferences": "1.74.3",
    "@theia/process": "1.74.3",
    "@theia/property-view": "1.74.3",
    "@theia/workspace": "1.74.3"
  },
  "devDependencies": {
    "@hydranium/core": "^1.0.0-next",
    "@hydranium/example-order-flow-server": "0.0.0",
    "@hydranium/example-order-flow-vscode-servers": "0.0.0",
    "@playwright/test": "^1.49.0",
    "@theia/bundle-plugin": "1.74.3",
    "@theia/cli": "1.74.3",
    "@theia/playwright": "1.74.3",
    "electron": "42.11.16",
    "esbuild-plugins-node-modules-polyfill": "^1.6.7",
    "rimraf": "^5.0.0",
    "yargs": "^17.7.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Order Flow — Theia Demo",
        "connectionBufferBytes": 102400,
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    },
    "backend": {
      "config": {
        "connectionBufferBytes": 102400,
        "frontendConnectionTimeout": 60000
      }
    }
  }
}
