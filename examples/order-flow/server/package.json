{
  "name": "@hydranium/example-order-flow-server",
  "version": "0.0.0",
  "private": true,
  "description": "Three-grammar order-fulfillment example: a `.domain` structural language, a `.process` behavioural one and a `.layout` layout overlay over one shared AST.",
  "homepage": "https://github.com/eclipse-emfcloud/hydranium",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-emfcloud/hydranium.git",
    "directory": "examples/order-flow/server"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "order-flow-data-server": "lib/data-server-main.js",
    "order-flow-server": "lib/main.js"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "npm run generate && tsc",
    "clean": "rimraf lib syntaxes src/language-server/generated src/language-server/generated-transfer tsconfig.tsbuildinfo",
    "generate": "npm run langium:generate && npm run generate:transfer-model",
    "generate:large-workspace": "node scripts/generate-large-workspace.mjs",
    "generate:transfer-model": "hydranium-cli generate-transfer-model --ast-file src/language-server/generated/ast.ts --augmentation-file src/language-server/ast.ts --out-file src/language-server/generated-transfer/transfer-model.ts --element-type-name OrderFlowElement --terminals-name OrderFlowTerminals --regen-command \"Run: npm --prefix examples/order-flow/server run generate:transfer-model\"",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "lint": "eslint src test --max-warnings 0",
    "measure-memory": "node --expose-gc --max-old-space-size=8192 lib/measure-memory.js",
    "start": "node lib/main.js --stdio",
    "test": "npm run typecheck:test && vitest run",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "watch": "concurrently --kill-others --names \"langium,tsc\" --prefix-colors \"green,blue\" \"npm run langium:watch\" \"tsc --watch --preserveWatchOutput\""
  },
  "dependencies": {
    "@eclipse-glsp/graph": "2.7.0",
    "@eclipse-glsp/server": "2.7.0",
    "@hydranium/core": "1.0.0-next",
    "@hydranium/data-server": "1.0.0-next",
    "@hydranium/glsp-server": "1.0.0-next",
    "@hydranium/langium": "1.0.0-next",
    "@hydranium/protocol": "1.0.0-next",
    "inversify": "^6.1.3",
    "langium": "^4.3.1",
    "reflect-metadata": "~0.2.2",
    "vscode-jsonrpc": "~9.0.1",
    "vscode-languageserver": "~10.0.1"
  },
  "devDependencies": {
    "@eclipse-glsp/protocol": "2.7.0",
    "@hydranium/cli": "1.0.0-next",
    "@hydranium/conformance": "1.0.0-next",
    "concurrently": "^9.0.0",
    "langium-cli": "~4.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.0",
    "vscode-languageserver-protocol": "~3.18.2"
  }
}
